#!/usr/bin/env python3
"""Benchmark four installed ELF linkers over one captured final link.

Runs the captured compiler-driver link described by a workload manifest
exactly 24 times (one warm-up pass plus five timed rounds, in the manifest
order), under strace, and attributes every link to the linker process the
driver actually execve()d.  Each freshly produced output is validated with
the manifest probe.  On success a JSON report is written; any identity,
link, output or probe failure exits nonzero and leaves no report.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time


LINKERS = ("bfd", "gold", "lld", "mold")

THREAD_ARGS = {
    "bfd": [],
    "gold": ["-Wl,--threads", "-Wl,--thread-count=2"],
    "lld": ["-Wl,--threads=2"],
    "mold": ["-Wl,--threads=2", "-Wl,--no-fork"],
}
EFFECTIVE_THREADS = {"bfd": 1, "gold": 2, "lld": 2, "mold": 2}

# Case-insensitive family markers, tested in this order.
FAMILY_MARKERS = (
    ("mold", "mold"),
    ("gnu gold", "gold"),
    ("lld", "lld"),
    ("gnu ld", "bfd"),
)

LINKER_NAME_RE = re.compile(r"^(?:ld|ld64|lld|mold|gold)(?:[.-].*)?$")
_QUOTED_RE = re.compile(r'"((?:[^"\\]|\\.)*)"')
_PID_RE = re.compile(r"\s*(\d+)\s+")
_RESUMED_RE = re.compile(r"\s*(\d+)\s+<\.\.\. execve resumed>\)\s*=\s*(-?\d+)")

LINK_TIMEOUT = 600.0
PROBE_TIMEOUT = 60.0


class HarnessError(RuntimeError):
    """The benchmark could not complete a required step."""


def log(message: str) -> None:
    print(f"linkbench: {message}", file=sys.stderr)


def remove_file(path: str) -> None:
    try:
        os.remove(path)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
# Manifest handling
# ---------------------------------------------------------------------------

def validate_order(value, label):
    if (
        not isinstance(value, list)
        or len(value) != len(LINKERS)
        or sorted(value) != sorted(LINKERS)
    ):
        raise HarnessError(f"{label} must contain each of {LINKERS} exactly once")
    return list(value)


def load_manifest(workload_dir):
    manifest_path = os.path.join(workload_dir, "workload.json")
    try:
        with open(manifest_path, "r", encoding="utf-8") as handle:
            manifest = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        raise HarnessError(f"cannot read workload manifest: {exc}") from exc
    if not isinstance(manifest, dict) or manifest.get("schema_version") != 1:
        raise HarnessError("unsupported workload schema")
    workload_id = manifest.get("workload_id")
    if not isinstance(workload_id, str) or not workload_id:
        raise HarnessError("workload_id must be a nonempty string")
    driver = manifest.get("driver")
    if not isinstance(driver, str) or not os.path.isabs(driver):
        raise HarnessError("driver must be an absolute path")
    if not os.path.isfile(driver):
        raise HarnessError(f"driver does not exist: {driver}")
    response_file = manifest.get("response_file")
    if not isinstance(response_file, str) or not response_file:
        raise HarnessError("response_file must be a nonempty string")
    if os.path.isabs(response_file):
        raise HarnessError("response_file must be a relative path")
    response_path = os.path.abspath(os.path.join(workload_dir, response_file))
    if os.path.commonpath([response_path, workload_dir]) != workload_dir:
        raise HarnessError("response_file escapes the workload directory")
    if not os.path.isfile(response_path):
        raise HarnessError(f"response file does not exist: {response_path}")
    warmup = validate_order(manifest.get("warmup_order"), "warmup_order")
    rounds = manifest.get("timed_rounds")
    if not isinstance(rounds, list) or len(rounds) != 5:
        raise HarnessError("timed_rounds must contain exactly five rounds")
    timed = [
        validate_order(order, f"timed_rounds[{index}]")
        for index, order in enumerate(rounds)
    ]
    probe = manifest.get("probe")
    if not isinstance(probe, dict):
        raise HarnessError("probe is missing")
    probe_argv = probe.get("argv")
    if (
        not isinstance(probe_argv, list)
        or not probe_argv
        or not all(isinstance(argument, str) for argument in probe_argv)
    ):
        raise HarnessError("probe.argv must be a nonempty string array")
    if not isinstance(probe.get("expected_returncode"), int):
        raise HarnessError("probe.expected_returncode must be an integer")
    for key in ("expected_stdout", "expected_stderr"):
        if not isinstance(probe.get(key), str):
            raise HarnessError(f"probe.{key} must be a string")
    return manifest, response_path, warmup, timed


# ---------------------------------------------------------------------------
# strace execve log parsing
# ---------------------------------------------------------------------------

_C_ESCAPES = {
    "n": "\n", "t": "\t", "r": "\r", "a": "\a", "b": "\b",
    "f": "\f", "v": "\v", "\\": "\\", '"': '"', "'": "'", "?": "?",
}


def unescape_c(text: str) -> str:
    out = []
    index, length = 0, len(text)
    while index < length:
        char = text[index]
        if char != "\\" or index + 1 >= length:
            out.append(char)
            index += 1
            continue
        nxt = text[index + 1]
        if nxt in _C_ESCAPES:
            out.append(_C_ESCAPES[nxt])
            index += 2
        elif nxt == "x":
            end = index + 2
            while end < length and end < index + 4 and text[end] in "0123456789abcdefABCDEF":
                end += 1
            digits = text[index + 2:end]
            out.append(chr(int(digits, 16)) if digits else "x")
            index = end
        elif nxt in "01234567":
            end = index + 1
            while end < length and end < index + 4 and text[end] in "01234567":
                end += 1
            out.append(chr(int(text[index + 1:end], 8)))
            index = end
        else:
            out.append(nxt)
            index += 2
    return "".join(out)


def parse_execve_call(line: str):
    """Parse one complete execve call line.

    Returns (pid, path, argv, status) with status in {"ok", "fail",
    "pending"}, or None if the line is not a complete execve call.
    """
    pid_match = _PID_RE.match(line)
    if not pid_match:
        return None
    pid = int(pid_match.group(1))
    start = line.find('execve("', pid_match.end())
    if start < 0:
        return None
    path_match = _QUOTED_RE.match(line, start + len("execve("))
    if not path_match:
        return None
    path = unescape_c(path_match.group(1))
    argv = []
    pos = path_match.end()
    if line.startswith(", [", pos):
        pos += 2  # now at '['
        depth = 0
        in_string = False
        escaped = False
        end = -1
        index = pos
        while index < len(line):
            char = line[index]
            if in_string:
                if escaped:
                    escaped = False
                elif char == "\\":
                    escaped = True
                elif char == '"':
                    in_string = False
            else:
                if char == '"':
                    in_string = True
                elif char == "[":
                    depth += 1
                elif char == "]":
                    depth -= 1
                    if depth == 0:
                        end = index
                        break
            index += 1
        if end >= 0:
            argv = [unescape_c(item) for item in _QUOTED_RE.findall(line[pos + 1:end])]
    stripped = line.rstrip()
    if stripped.endswith("<unfinished ...>"):
        status = "pending"
    elif re.search(r"=\s*0\s*$", stripped):
        status = "ok"
    else:
        status = "fail"
    return pid, path, argv, status


def successful_execves(trace_path: str):
    """Return [(path, argv), ...] of successful execve events, in order."""
    events = []
    pending = {}
    try:
        handle = open(trace_path, "r", encoding="utf-8", errors="replace")
    except OSError as exc:
        raise HarnessError(f"cannot read strace log {trace_path}: {exc}") from exc
    with handle:
        for line in handle:
            if "execve" not in line:
                continue
            resumed = _RESUMED_RE.match(line)
            if resumed is not None:
                pid = int(resumed.group(1))
                if resumed.group(2) == "0" and pid in pending:
                    events.append(pending.pop(pid))
                continue
            parsed = parse_execve_call(line)
            if parsed is None:
                continue
            pid, path, argv, status = parsed
            if status == "ok":
                events.append((path, argv))
            elif status == "pending":
                pending[pid] = (path, argv)
    return events


def is_linker_shaped(path: str) -> bool:
    basename = path.rsplit("/", 1)[-1].lower()
    return bool(LINKER_NAME_RE.match(basename))


def attribute_link(trace_path: str, output: str) -> str:
    """Return the verbatim execve path of the linker that performed the link."""
    shaped = [
        (path, argv)
        for path, argv in successful_execves(trace_path)
        if is_linker_shaped(path)
    ]
    if not shaped:
        raise HarnessError("the driver did not execute any linker process")
    # The process that performed the link is invoked with the link job, in
    # particular with the output path among its arguments; bracketing or
    # helper processes are invoked bare.  Prefer the last such process so a
    # wrapper re-executing the real linker is attributed to the real one.
    with_output = [(path, argv) for path, argv in shaped if output in argv[1:]]
    if with_output:
        return with_output[-1][0]
    with_arguments = [(path, argv) for path, argv in shaped if len(argv) > 1]
    if with_arguments:
        return with_arguments[-1][0]
    return shaped[-1][0]


# ---------------------------------------------------------------------------
# Subprocess helpers
# ---------------------------------------------------------------------------

def run_link(strace_path, driver, response_path, linker, output,
             workload_dir, environment, trace_path):
    command = [
        strace_path,
        "-f",
        "-e", "trace=execve",
        "-s", "65536",
        "-o", trace_path,
        driver,
        f"-fuse-ld={linker}",
        *THREAD_ARGS[linker],
        f"@{response_path}",
        "-o",
        output,
    ]
    started = time.monotonic_ns()
    try:
        completed = subprocess.run(
            command,
            cwd=workload_dir,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=LINK_TIMEOUT,
        )
    except subprocess.TimeoutExpired as exc:
        raise HarnessError(f"{linker} link timed out") from exc
    except OSError as exc:
        raise HarnessError(f"cannot start driver {driver}: {exc}") from exc
    elapsed = time.monotonic_ns() - started
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", "replace")[-400:].strip()
        raise HarnessError(
            f"{linker} link exited with status {completed.returncode}: {detail}"
        )
    return elapsed


def probe_version(invoked_path, workload_dir, environment):
    try:
        completed = subprocess.run(
            [invoked_path, "--version"],
            cwd=workload_dir,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=PROBE_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise HarnessError(f"cannot run {invoked_path} --version: {exc}") from exc
    if completed.returncode != 0:
        raise HarnessError(
            f"{invoked_path} --version exited with status {completed.returncode}"
        )
    text = completed.stdout.decode("utf-8", "replace")
    line = ""
    for candidate in text.splitlines():
        if candidate.strip():
            line = candidate
            break
    if not line:
        raise HarnessError(f"{invoked_path} --version produced no output")
    lowered = line.lower()
    for marker, family in FAMILY_MARKERS:
        if marker in lowered:
            return line, family
    raise HarnessError(
        f"cannot classify linker at {invoked_path} from version line {line!r}"
    )


def check_output(output):
    try:
        mode = os.lstat(output).st_mode
    except OSError as exc:
        raise HarnessError(f"link did not create output {output}: {exc}") from exc
    if not stat.S_ISREG(mode):
        raise HarnessError(f"output {output} is not a regular file")


def run_probe(manifest, output, workload_dir, environment):
    probe = manifest["probe"]
    argv = [output if argument == "{output}" else argument
            for argument in probe["argv"]]
    try:
        completed = subprocess.run(
            argv,
            cwd=workload_dir,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=PROBE_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise HarnessError(f"cannot start probe {argv[0]}: {exc}") from exc
    if completed.returncode != probe["expected_returncode"]:
        raise HarnessError(
            f"probe for {output} exited {completed.returncode}, "
            f"expected {probe['expected_returncode']}"
        )
    if completed.stdout != probe["expected_stdout"].encode("utf-8"):
        raise HarnessError(f"probe for {output} printed unexpected stdout")
    if completed.stderr != probe["expected_stderr"].encode("utf-8"):
        raise HarnessError(f"probe for {output} printed unexpected stderr")


# ---------------------------------------------------------------------------
# Benchmark driver
# ---------------------------------------------------------------------------

def benchmark(workload_arg: str, report_arg: str) -> None:
    workload_dir = os.path.abspath(workload_arg)
    report_path = os.path.abspath(report_arg)

    # Remove any existing report before linking; failures leave no report.
    try:
        os.remove(report_path)
    except FileNotFoundError:
        pass
    except OSError as exc:
        raise HarnessError(f"cannot remove existing report {report_path}: {exc}") from exc

    manifest, response_path, warmup_order, timed_rounds = load_manifest(workload_dir)

    strace_path = shutil.which("strace")
    if strace_path is None:
        for candidate in ("/usr/bin/strace", "/usr/local/bin/strace", "/bin/strace"):
            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
                strace_path = candidate
                break
    if strace_path is None:
        raise HarnessError("strace is not available")
    driver = manifest["driver"]

    schedule = [(linker, False) for linker in warmup_order]
    for round_order in timed_rounds:
        schedule.extend((linker, True) for linker in round_order)

    samples = {linker: [] for linker in LINKERS}
    invoked_paths = {}
    versions = {}

    with tempfile.TemporaryDirectory(prefix="linkbench-") as scratch:
        temporary = os.path.join(scratch, "tmp")
        os.mkdir(temporary)
        environment = os.environ.copy()
        environment.update(
            {
                "TMPDIR": temporary,
                "TMP": temporary,
                "TEMP": temporary,
                "LC_ALL": "C",
                "LANG": "C",
            }
        )
        outputs = {
            linker: os.path.join(scratch, f"output-{linker}")
            for linker in LINKERS
        }
        for position, (linker, timed) in enumerate(schedule):
            output = outputs[linker]
            remove_file(output)
            trace_path = os.path.join(scratch, f"trace-{position}.log")
            elapsed = run_link(
                strace_path,
                driver,
                response_path,
                linker,
                output,
                workload_dir,
                environment,
                trace_path,
            )
            path = attribute_link(trace_path, output)
            if linker in invoked_paths:
                if invoked_paths[linker] != path:
                    raise HarnessError(
                        f"{linker} link {position} executed {path!r}, "
                        f"expected {invoked_paths[linker]!r}"
                    )
            else:
                version, family = probe_version(path, workload_dir, environment)
                if family != linker:
                    raise HarnessError(
                        f"{linker} link executed {path!r} which identifies "
                        f"as {family}: {version!r}"
                    )
                invoked_paths[linker] = path
                versions[linker] = version
                log(f"{linker}: executed {path} ({version})")
            check_output(output)
            run_probe(manifest, output, workload_dir, environment)
            if timed:
                samples[linker].append(elapsed)
            log(
                f"link {position + 1}/24 ({linker}"
                f"{', timed' if timed else ', warm-up'}) took {elapsed} ns"
            )

    medians = {}
    results = []
    for linker in LINKERS:
        values = samples[linker]
        if len(values) != 5:
            raise HarnessError(f"{linker} has {len(values)} samples, expected 5")
        median = sorted(values)[2]
        medians[linker] = median
        results.append(
            {
                "linker": linker,
                "invoked_path": invoked_paths[linker],
                "version": versions[linker],
                "effective_threads": EFFECTIVE_THREADS[linker],
                "samples_ns": values,
                "median_ns": median,
            }
        )
    ranking = sorted(LINKERS, key=lambda linker: medians[linker])
    report = {
        "schema_version": 1,
        "workload_id": manifest["workload_id"],
        "results": results,
        "ranking": ranking,
    }
    report_dir = os.path.dirname(report_path)
    if report_dir:
        os.makedirs(report_dir, exist_ok=True)
    with open(report_path, "w", encoding="utf-8") as handle:
        json.dump(report, handle, indent=2)
        handle.write("\n")
    log(f"wrote report to {report_path}")


def main() -> int:
    if len(sys.argv) != 3:
        print(
            "usage: /app/linkbench <workload-directory> <report-json>",
            file=sys.stderr,
        )
        return 2
    try:
        benchmark(sys.argv[1], sys.argv[2])
    except HarnessError as exc:
        log(str(exc))
        remove_file(sys.argv[2])
        return 1
    except (OSError, KeyError, TypeError, ValueError) as exc:
        log(f"unexpected failure: {exc}")
        remove_file(sys.argv[2])
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
