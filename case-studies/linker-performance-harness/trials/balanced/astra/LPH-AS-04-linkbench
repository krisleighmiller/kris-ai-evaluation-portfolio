#!/usr/bin/env python3
"""Replay a captured driver link, observing the linker that produces its output."""

from __future__ import annotations

import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


LINKERS = ("bfd", "gold", "lld", "mold")
THREAD_ARGS = {
    "bfd": [],
    "gold": ["-Wl,--threads", "-Wl,--thread-count=2"],
    "lld": ["-Wl,--threads=2"],
    "mold": ["-Wl,--threads=2", "-Wl,--no-fork"],
}
SELF = os.path.abspath(__file__)


class HarnessError(RuntimeError):
    pass


def require(condition, message):
    if not condition:
        raise HarnessError(message)


def outside(path, workload):
    return not path.resolve().is_relative_to(workload)


def validate_order(order, name):
    require(isinstance(order, list) and len(order) == 4
            and all(isinstance(item, str) for item in order)
            and set(order) == set(LINKERS),
            f"{name} must contain each linker exactly once")


def load_workload(workload):
    manifest = json.loads((workload / "workload.json").read_text(encoding="utf-8"))
    require(isinstance(manifest, dict), "manifest must be an object")
    require(type(manifest.get("schema_version")) is int
            and manifest["schema_version"] == 1, "unsupported workload schema")
    require(isinstance(manifest.get("workload_id"), str)
            and manifest["workload_id"], "missing workload_id")
    driver = manifest.get("driver")
    require(isinstance(driver, str) and os.path.isabs(driver),
            "driver must be an absolute path")
    validate_order(manifest.get("warmup_order"), "warmup_order")
    rounds = manifest.get("timed_rounds")
    require(isinstance(rounds, list) and len(rounds) == 5,
            "timed_rounds must contain five rounds")
    for order in rounds:
        validate_order(order, "timed round")
    relative = manifest.get("response_file")
    require(isinstance(relative, str) and relative and not os.path.isabs(relative)
            and ".." not in Path(relative).parts, "unsafe response_file")
    response = (workload / relative).resolve()
    require(response.is_relative_to(workload) and response.is_file(),
            "response_file must be a file within the workload")
    probe = manifest.get("probe")
    require(isinstance(probe, dict), "missing probe")
    argv = probe.get("argv")
    require(isinstance(argv, list) and argv
            and all(isinstance(arg, str) for arg in argv), "invalid probe argv")
    require(type(probe.get("expected_returncode")) is int
            and isinstance(probe.get("expected_stdout"), str)
            and isinstance(probe.get("expected_stderr"), str), "invalid probe expectations")
    return manifest, response


def run(command, *, cwd, environment):
    return subprocess.run(command, cwd=cwd, env=environment,
                          stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=False)


def timed_driver(timing_file, command):
    # This small supervisor is itself traced. Tracer startup, trace parsing,
    # version checks and semantic probes are outside the measured interval.
    start = time.monotonic_ns()
    child = subprocess.Popen(command, stdin=subprocess.DEVNULL)
    returncode = child.wait()
    elapsed = time.monotonic_ns() - start
    Path(timing_file).write_text(json.dumps([returncode, elapsed]), encoding="ascii")
    return 0


def trace_calls(trace):
    """Reassemble strace's interleaved unfinished/resumed system calls."""
    pending = {}
    for line in trace.read_text(encoding="ascii").splitlines():
        match = re.match(r"^(\d+)\s+(.*)$", line)
        if not match:
            continue
        pid, call = int(match[1]), match[2]
        if call.endswith(" <unfinished ...>"):
            pending[pid] = call[:-len(" <unfinished ...>")]
            continue
        resumed = re.match(r"^<\.\.\. \w+ resumed>(.*)$", call)
        if resumed:
            require(pid in pending, "incomplete execution trace")
            call = pending.pop(pid) + resumed[1]
        match = re.match(r"^(\w+)\((.*)\)\s+=\s+(-?\d+)(?:\s|$)", call)
        if match:
            yield pid, match[1], match[2], int(match[3])


def arguments(text):
    """Split syscall arguments; -xx makes every quoted byte unambiguous."""
    result, start, depth, quoted = [], 0, 0, False
    for index, char in enumerate(text):
        if char == '"':
            quoted = not quoted
        elif not quoted:
            if char in "([{":
                depth += 1
            elif char in ")]}":
                depth -= 1
            elif char == "," and depth == 0:
                result.append(text[start:index].strip())
                start = index + 1
    result.append(text[start:].strip())
    return result


def trace_string(text):
    require(re.fullmatch(r'"(?:\\x[0-9a-fA-F]{2})*"', text) is not None,
            "truncated or invalid trace string")
    return os.fsdecode(bytes.fromhex(text[1:-1].replace("\\x", "")))


def observed_linker(trace, output, workload):
    # Do not guess from a selector, PATH lookup, basename, or the last exec.
    # Attribute the final output open/publication to its executable, including
    # inherited executable contexts in linker worker processes and threads.
    parents = {}
    executions = {}
    publications = []
    for index, (pid, name, text, result) in enumerate(trace_calls(trace)):
        if result < 0:
            continue
        args = arguments(text)
        if name in ("clone", "clone3", "fork", "vfork") and result > 0:
            parents[result] = (pid, index)
        elif name in ("execve", "execveat") and result == 0:
            path = trace_string(args[0 if name == "execve" else 1])
            executions.setdefault(pid, []).append((index, path))
        else:
            destination = None
            if name in ("open", "openat"):
                offset = 0 if name == "open" else 1
                if "O_WRONLY" in args[offset + 1] or "O_RDWR" in args[offset + 1]:
                    destination = args[offset]
            elif name == "creat":
                destination = args[0]
            elif name in ("rename", "renameat", "renameat2"):
                destination = args[1 if name == "rename" else 3]
            if destination is not None:
                path = trace_string(destination)
                if os.path.abspath(os.path.join(workload, path)) == str(output):
                    publications.append((index, pid))
    require(publications, "no traced process created the link output")
    index, pid = publications[-1]
    visited = set()
    while pid not in visited:
        visited.add(pid)
        previous = [(when, path) for when, path in executions.get(pid, [])
                    if when <= index]
        if previous:
            path = previous[-1][1]
            require(os.path.isabs(path), "linker exec path was not absolute")
            return path  # Preserve spelling, including symlinks, '.' and '..'.
        require(pid in parents, "cannot attribute output to an execve event")
        pid, fork_index = parents[pid]
        index = min(index, fork_index)
    raise HarnessError("cyclic process ancestry in trace")


def check_identity(linker, path, discovered, *, workload, environment):
    result = run([path, "--version"], cwd=workload, environment=environment)
    require(result.returncode == 0, f"{path} --version failed")
    lines = result.stdout.decode("utf-8", errors="surrogateescape").splitlines()
    version = next((line for line in lines if line.strip()), "")
    require(version, f"{path} has no version output")
    lower = version.lower()
    family = next((family for marker, family in
                   (("mold", "mold"), ("gnu gold", "gold"),
                    ("lld", "lld"), ("gnu ld", "bfd"))
                   if marker in lower), None)
    require(family == linker, f"{linker} executed {path}, whose version is {version!r}")
    if linker in discovered:
        require(discovered[linker][0] == path, f"{linker} changed its invoked path")
    else:
        discovered[linker] = (path, version)


def probe_output(output, manifest, *, workload, environment):
    require(stat.S_ISREG(output.lstat().st_mode), "output is not itself a regular file")
    probe = manifest["probe"]
    command = [str(output) if arg == "{output}" else arg for arg in probe["argv"]]
    result = run(command, cwd=workload, environment=environment)
    require(result.returncode == probe["expected_returncode"]
            and result.stdout == probe["expected_stdout"].encode("utf-8")
            and result.stderr == probe["expected_stderr"].encode("utf-8"),
            "output failed the manifest probe")


def execute_link(manifest, response, linker, scratch, discovered, *, workload, environment):
    output = scratch / "linked-output"
    output.unlink(missing_ok=True)
    trace = scratch / "trace"
    timing = scratch / "timing.json"
    timing.unlink(missing_ok=True)
    command = [manifest["driver"], f"-fuse-ld={linker}", *THREAD_ARGS[linker],
               f"@{response}", "-o", str(output)]
    traced = ["strace", "-f", "-qq", "-v", "-xx", "-s", "0",
              "-e", "trace=execve,execveat,clone,clone3,fork,vfork,open,openat,creat,rename,renameat,renameat2",
              "-o", str(trace), sys.executable, SELF, "--timed-driver", str(timing), *command]
    result = run(traced, cwd=workload, environment=environment)
    require(result.returncode == 0,
            f"traced driver failed: {result.stderr.decode('utf-8', errors='replace')}")
    returncode, elapsed = json.loads(timing.read_text(encoding="ascii"))
    require(returncode == 0,
            f"{linker} driver exited {returncode}: {result.stderr.decode('utf-8', errors='replace')}")
    require(type(elapsed) is int and elapsed > 0, "invalid driver duration")
    # Probe immediately after the link, before any version metadata process.
    probe_output(output, manifest, workload=workload, environment=environment)
    path = observed_linker(trace, output, workload)
    check_identity(linker, path, discovered, workload=workload, environment=environment)
    return elapsed


def benchmark(workload, report_path):
    workload = workload.resolve()
    # Resolve only the parent: unlinking a preexisting report symlink must not
    # unlink its target. No report is published until all checks have passed.
    report_path = report_path.parent.resolve() / report_path.name
    require(outside(report_path.parent, workload), "report must be outside the workload")
    report_path.unlink(missing_ok=True)
    manifest, response = load_workload(workload)
    samples = {linker: [] for linker in LINKERS}
    discovered = {}
    # Ignore a caller's TMPDIR if it points inside the read-only workload.
    # gettempdir() can create trial files in TMPDIR before returning a path.
    # Inspect candidates ourselves so even those trial writes cannot touch it.
    candidates = [Path(os.environ[key]) for key in ("TMPDIR", "TMP", "TEMP")
                  if os.environ.get(key)] + [Path('/tmp'), Path.cwd()]
    temp_parent = next((path.resolve() for path in candidates
                        if outside(path, workload) and os.access(path, os.W_OK | os.X_OK)), None)
    require(temp_parent is not None, "no writable temporary directory outside the workload")
    with tempfile.TemporaryDirectory(prefix="linkbench-", dir=temp_parent) as temp:
        scratch = Path(temp).resolve()
        environment = os.environ.copy()
        environment.update(TMPDIR=str(scratch), TMP=str(scratch), TEMP=str(scratch),
                           LC_ALL="C", LANG="C")
        for linker in manifest["warmup_order"]:
            execute_link(manifest, response, linker, scratch, discovered,
                         workload=workload, environment=environment)
        for order in manifest["timed_rounds"]:
            for linker in order:
                samples[linker].append(execute_link(
                    manifest, response, linker, scratch, discovered,
                    workload=workload, environment=environment))
    medians = {linker: sorted(values)[2] for linker, values in samples.items()}
    report = {
        "schema_version": 1,
        "workload_id": manifest["workload_id"],
        "results": [{"linker": linker, "invoked_path": discovered[linker][0],
                     "version": discovered[linker][1],
                     "effective_threads": 1 if linker == "bfd" else 2,
                     "samples_ns": samples[linker], "median_ns": medians[linker]}
                    for linker in LINKERS],
        "ranking": sorted(LINKERS, key=lambda linker: medians[linker]),
    }
    report_path.parent.mkdir(parents=True, exist_ok=True)
    temporary_report = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", prefix=".linkbench-",
                                         dir=report_path.parent, delete=False) as stream:
            temporary_report = Path(stream.name)
            json.dump(report, stream, indent=2)
            stream.write("\n")
        os.replace(temporary_report, report_path)
    finally:
        if temporary_report is not None:
            temporary_report.unlink(missing_ok=True)


def main():
    try:
        if len(sys.argv) >= 4 and sys.argv[1] == "--timed-driver":
            return timed_driver(sys.argv[2], sys.argv[3:])
        if len(sys.argv) != 3:
            print("usage: linkbench <workload-directory> <report-json>", file=sys.stderr)
            return 2
        benchmark(Path(sys.argv[1]), Path(sys.argv[2]))
        return 0
    except (HarnessError, OSError, ValueError, KeyError, TypeError) as exc:
        print(f"linkbench: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
