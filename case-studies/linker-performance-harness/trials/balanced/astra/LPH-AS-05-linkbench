#!/usr/bin/env python3
"""Replay captured driver links, checking the identity of each output's linker."""

from __future__ import annotations

import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


LINKERS = ("bfd", "gold", "lld", "mold")
THREAD_ARGS = {
    "bfd": [],
    "gold": ["-Wl,--threads", "-Wl,--thread-count=2"],
    "lld": ["-Wl,--threads=2"],
    "mold": ["-Wl,--threads=2", "-Wl,--no-fork"],
}
SELF = os.path.abspath(__file__)


class HarnessError(RuntimeError):
    pass


def require(condition, message):
    if not condition:
        raise HarnessError(message)


def load_workload(workload):
    manifest = json.loads((workload / "workload.json").read_text(encoding="utf-8"))
    require(isinstance(manifest, dict), "manifest must be an object")
    require(type(manifest.get("schema_version")) is int
            and manifest["schema_version"] == 1, "unsupported workload schema")
    require(isinstance(manifest.get("workload_id"), str)
            and manifest["workload_id"], "workload_id must be a nonempty string")
    driver = manifest.get("driver")
    require(isinstance(driver, str) and os.path.isabs(driver),
            "driver must be an absolute path")

    def order(value):
        return (isinstance(value, list) and len(value) == 4
                and all(isinstance(item, str) for item in value)
                and set(value) == set(LINKERS))

    require(order(manifest.get("warmup_order")), "invalid warmup_order")
    rounds = manifest.get("timed_rounds")
    require(isinstance(rounds, list) and len(rounds) == 5
            and all(order(value) for value in rounds), "invalid timed_rounds")
    response_name = manifest.get("response_file")
    require(isinstance(response_name, str) and response_name
            and not os.path.isabs(response_name)
            and ".." not in Path(response_name).parts, "unsafe response_file")
    response = (workload / response_name).resolve()
    require(response.is_relative_to(workload) and response.is_file(),
            "response_file must be a file inside the workload")
    probe = manifest.get("probe")
    require(isinstance(probe, dict), "missing probe")
    require(isinstance(probe.get("argv"), list) and probe["argv"]
            and all(isinstance(arg, str) for arg in probe["argv"]),
            "probe.argv must be a nonempty argument array")
    require(type(probe.get("expected_returncode")) is int
            and isinstance(probe.get("expected_stdout"), str)
            and isinstance(probe.get("expected_stderr"), str), "invalid probe expectations")
    return manifest, response


def run(command, *, cwd, environment):
    return subprocess.run(command, cwd=cwd, env=environment,
                          stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE)


def timed_driver(command_file, timing_file):
    """Executed under strace; tracer/interpreter startup is outside the sample.

    Only Popen and waiting for the complete driver are inside the monotonic
    interval. Diagnostics go to scratch files, so pipe draining cannot delay
    the recorded exit time.
    """
    command = json.loads(Path(command_file).read_text(encoding="utf-8"))
    with open(timing_file + ".stdout", "wb") as stdout, \
            open(timing_file + ".stderr", "wb") as stderr:
        started = time.monotonic_ns()
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                   stdout=stdout, stderr=stderr)
        returncode = process.wait()
        elapsed = time.monotonic_ns() - started
    Path(timing_file).write_text(json.dumps({"returncode": returncode,
                                           "elapsed_ns": elapsed}), encoding="utf-8")
    return 0


# -xx makes every traced string a lossless sequence of hex-escaped bytes.
# No shell parsing, path canonicalization, or inference from -fuse-ld is used
# to recover the executable path.
QUOTED = re.compile(r'"((?:\\x[0-9a-fA-F]{2})*)"')


def unquote(value):
    match = QUOTED.fullmatch(value.strip())
    require(match is not None, f"unreadable traced string: {value}")
    return os.fsdecode(bytes.fromhex(match[1].replace("\\x", "")))


def arguments(text):
    """Split syscall arguments, leaving quoted strings and nested arrays intact."""
    result, start, depth, quoted, escaped = [], 0, 0, False, False
    for index, char in enumerate(text):
        if quoted:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                quoted = False
        elif char == '"':
            quoted = True
        elif char in "[{(":
            depth += 1
        elif char in "]})":
            depth -= 1
        elif char == "," and depth == 0:
            result.append(text[start:index].strip())
            start = index + 1
    result.append(text[start:].strip())
    return result


def trace_events(trace):
    """Reassemble interleaved strace calls in syscall-entry order."""
    pending, events = {}, []
    for index, line in enumerate(trace.read_text(encoding="ascii").splitlines()):
        match = re.match(r"\s*(\d+)\s+(.*)", line)
        require(match is not None, "unrecognized strace record")
        pid, text = int(match[1]), match[2]
        if text.endswith("<unfinished ...>"):
            pending[pid] = (index, text[:-len("<unfinished ...>")])
            continue
        resumed = re.match(r"<\.\.\. (\w+) resumed>(.*)", text)
        if resumed:
            require(pid in pending, "unmatched resumed syscall")
            index, prefix = pending.pop(pid)
            text = prefix + resumed[2]
        call = re.match(r"(\w+)\((.*)\)\s+=\s+(-?\d+)(?:\s.*)?$", text)
        if call:
            events.append((index, pid, call[1], arguments(call[2]), int(call[3])))
    return sorted(events)


def output_linker(trace, output, workload):
    """Follow output creation/rename back to a successful execve image.

    Merely looking at the first or last ld-shaped exec is insufficient: a
    driver may run helpers before or after its actual link. File provenance
    identifies the image that opened the result for writing, including an
    inherited linker image in a worker thread and atomic temporary-file output.
    """
    images, parents, files = {}, {}, {}

    def image(pid, when):
        for sequence, path in reversed(images.get(pid, [])):
            if sequence <= when:
                return path
        if pid in parents:
            parent, born = parents[pid]
            return image(parent, born)
        return None

    def filename(value, directory=None):
        path = unquote(value)
        if os.path.isabs(path):
            return os.path.normpath(path)
        # All benchmark output paths are absolute. Relative tool temporaries
        # with AT_FDCWD are relative to the driver's workload working directory.
        if directory is None or directory == "AT_FDCWD":
            return os.path.normpath(os.path.join(workload, path))
        return None

    events = trace_events(trace)
    # Build ancestry first: a child can run before its parent's clone resumes.
    for sequence, pid, name, args, result in events:
        if name in ("clone", "clone3", "fork", "vfork") and result > 0:
            parents[result] = (pid, sequence)
        elif name == "execve" and result == 0:
            images.setdefault(pid, []).append((sequence, unquote(args[0])))
        elif name == "execveat" and result == 0:
            images.setdefault(pid, []).append((sequence, unquote(args[1])))

    for sequence, pid, name, args, result in events:
        if result < 0:
            continue
        owner = image(pid, sequence)
        if name in ("open", "openat", "creat"):
            if name == "openat":
                path, flags = filename(args[1], args[0]), args[2]
            else:
                path = filename(args[0])
                flags = args[1] if name == "open" else "O_WRONLY|O_CREAT|O_TRUNC"
            if path is not None and ("O_WRONLY" in flags or "O_RDWR" in flags):
                files[path] = owner
        elif name in ("rename", "renameat", "renameat2", "link", "linkat"):
            if name in ("rename", "link"):
                source, destination = filename(args[0]), filename(args[1])
            else:
                source = filename(args[1], args[0])
                destination = filename(args[3], args[2])
            if destination is not None:
                files[destination] = files.get(source, owner)
            if name.startswith("rename") and source != destination:
                files.pop(source, None)
        elif name in ("unlink", "unlinkat"):
            path = (filename(args[0]) if name == "unlink"
                    else filename(args[1], args[0]))
            files.pop(path, None)

    invoked = files.get(str(output))
    require(invoked is not None and os.path.isabs(invoked),
            "cannot identify the output-producing linker from execve events")
    return invoked


def probe_output(output, manifest, workload, environment):
    require(stat.S_ISREG(output.lstat().st_mode), "link output is not a regular file")
    probe = manifest["probe"]
    command = [str(output) if arg == "{output}" else arg for arg in probe["argv"]]
    result = run(command, cwd=workload, environment=environment)
    require(result.returncode == probe["expected_returncode"]
            and result.stdout == probe["expected_stdout"].encode("utf-8")
            and result.stderr == probe["expected_stderr"].encode("utf-8"),
            "link output failed the manifest probe")


def check_identity(linker, invoked, identities, workload, environment):
    result = run([invoked, "--version"], cwd=workload, environment=environment)
    require(result.returncode == 0, f"{invoked} --version failed")
    lines = result.stdout.decode("utf-8").splitlines()
    version = next((line for line in lines if line.strip()), "")
    family = next((family for marker, family in
                   (("mold", "mold"), ("gnu gold", "gold"),
                    ("lld", "lld"), ("gnu ld", "bfd"))
                   if marker in version.casefold()), None)
    require(family == linker,
            f"requested {linker}, but {invoked} identifies as {version!r}")
    if linker in identities:
        require(identities[linker][0] == invoked,
                f"{linker} executed a different path: {invoked}")
    else:
        identities[linker] = (invoked, version)


def execute_link(manifest, response, linker, output, scratch, workload,
                 environment, identities):
    output.unlink(missing_ok=True)
    command = [manifest["driver"], f"-fuse-ld={linker}", *THREAD_ARGS[linker],
               f"@{response}", "-o", str(output)]
    command_file = scratch / "command.json"
    timing_file = scratch / "timing.json"
    trace = scratch / "trace"
    command_file.write_text(json.dumps(command), encoding="utf-8")
    timing_file.unlink(missing_ok=True)
    traced = run([
        "strace", "-f", "-qq", "-s", "0", "-xx", "-o", str(trace),
        "-e", "trace=execve,execveat,clone,clone3,fork,vfork,open,openat,creat,"
              "rename,renameat,renameat2,link,linkat,unlink,unlinkat",
        sys.executable, SELF, "--timed-driver", str(command_file), str(timing_file),
    ], cwd=workload, environment=environment)
    require(traced.returncode == 0,
            "driver tracing failed: " + traced.stderr.decode("utf-8", "replace"))
    timing = json.loads(timing_file.read_text(encoding="utf-8"))
    require(timing["returncode"] == 0,
            f"{linker} driver exited {timing['returncode']}: "
            + Path(str(timing_file) + ".stderr").read_text(encoding="utf-8", errors="replace"))
    elapsed = timing["elapsed_ns"]
    require(type(elapsed) is int and elapsed > 0, "invalid driver duration")
    probe_output(output, manifest, workload, environment)
    invoked = output_linker(trace, output, workload)
    check_identity(linker, invoked, identities, workload, environment)
    return elapsed


def scratch_parent(workload):
    for candidate in (Path("/tmp"), Path.cwd()):
        candidate = candidate.resolve()
        if not candidate.is_relative_to(workload) and os.access(candidate, os.W_OK):
            return candidate
    raise HarnessError("no writable temporary directory outside the workload")


def benchmark(workload, report_path):
    workload = workload.resolve()
    # Resolve the parent only: unlink an existing report symlink itself.
    report_path = report_path.parent.resolve() / report_path.name
    require(not report_path.is_relative_to(workload), "report must be outside the workload")
    report_path.unlink(missing_ok=True)
    manifest, response = load_workload(workload)
    samples = {linker: [] for linker in LINKERS}
    identities = {}
    with tempfile.TemporaryDirectory(prefix="linkbench-", dir=scratch_parent(workload)) as temp:
        scratch = Path(temp)
        environment = os.environ.copy()
        environment.update(TMPDIR=temp, TMP=temp, TEMP=temp, LC_ALL="C", LANG="C")
        output = scratch / "linked-output"
        for linker in manifest["warmup_order"]:
            execute_link(manifest, response, linker, output, scratch, workload,
                         environment, identities)
        for order in manifest["timed_rounds"]:
            for linker in order:
                samples[linker].append(execute_link(
                    manifest, response, linker, output, scratch, workload,
                    environment, identities))

    medians = {linker: sorted(values)[2] for linker, values in samples.items()}
    report = {
        "schema_version": 1,
        "workload_id": manifest["workload_id"],
        "results": [{
            "linker": linker,
            "invoked_path": identities[linker][0],
            "version": identities[linker][1],
            "effective_threads": 1 if linker == "bfd" else 2,
            "samples_ns": samples[linker],
            "median_ns": medians[linker],
        } for linker in LINKERS],
        "ranking": sorted(LINKERS, key=medians.get),
    }
    report_path.parent.mkdir(parents=True, exist_ok=True)
    # Publish only a complete report, and clean up even a failed publication.
    temporary_report = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                         dir=report_path.parent, prefix=".linkbench-",
                                         delete=False) as stream:
            temporary_report = Path(stream.name)
            json.dump(report, stream, indent=2)
            stream.write("\n")
        os.replace(temporary_report, report_path)
    finally:
        if temporary_report is not None:
            temporary_report.unlink(missing_ok=True)


def main():
    try:
        if len(sys.argv) == 4 and sys.argv[1] == "--timed-driver":
            return timed_driver(sys.argv[2], sys.argv[3])
        if len(sys.argv) != 3:
            print("usage: linkbench <workload-directory> <report-json>", file=sys.stderr)
            return 2
        benchmark(Path(sys.argv[1]), Path(sys.argv[2]))
    except (HarnessError, OSError, KeyError, TypeError, ValueError) as exc:
        print(f"linkbench: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
